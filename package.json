{
  "name": "polygon-zkevm-regtech",
  "version": "1.0.0",
  "description": "Privacy-preserving KYC/AML compliance platform on Polygon zkEVM — UK GDPR, EU MiCA, eIDAS 2.0, ECA 2000",
  "scripts": {
    "compile":      "hardhat compile",
    "test":         "hardhat test",
    "deploy:test":  "hardhat run scripts/deploy.ts --network zkevm-testnet",
    "deploy:main":  "hardhat run scripts/deploy.ts --network zkevm-mainnet",
    "circuit:compile": "circom circuits/kyc_proof.circom --r1cs --wasm --sym -o circuits/artifacts",
    "circuit:setup":   "npm run circuit:ptau && npm run circuit:zkey",
    "circuit:ptau":    "snarkjs powersoftau new bn128 20 circuits/artifacts/pot20_0000.ptau -v",
    "circuit:zkey":    "snarkjs groth16 setup circuits/artifacts/kyc_proof.r1cs circuits/artifacts/pot20_final.ptau circuits/artifacts/kyc_proof_0000.zkey",
    "circuit:contribute": "snarkjs zkey contribute circuits/artifacts/kyc_proof_0000.zkey circuits/artifacts/kyc_proof_final.zkey",
    "circuit:exportvk":   "snarkjs zkey export verificationkey circuits/artifacts/kyc_proof_final.zkey circuits/artifacts/verification_key.json",
    "backend:dev":   "ts-node backend/src/server.ts",
    "backend:build": "tsc -p backend/tsconfig.json",
    "lint":          "eslint . --ext .ts,.sol"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "circomlibjs":     "^0.1.7",
    "ethers":          "^6.11.0",
    "express":         "^4.18.3",
    "snarkjs":         "^0.7.4",
    "axios":           "^1.6.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@types/express":  "^4.17.21",
    "@types/node":     "^20.11.24",
    "hardhat":         "^2.22.1",
    "ts-node":         "^10.9.2",
    "typescript":      "^5.4.2",
    "circom":          "^2.1.8",
    "dotenv":          "^16.4.5"
  }
}
